# 在 Vercel 项目 Settings → Environment Variables 里配置（本地开发可不配，会走内存存储，验证码打印在终端）

# ---- 存储（在线人数、验证码）：Vercel Marketplace 添加 "Upstash Redis" 后会自动注入下面两个变量之一 ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 或者（Vercel KV 命名）
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---- 发信：二选一 ----
# 方案 A：SMTP（QQ / 163 / 学校邮箱，用"授权码"当密码，可以发给任何人）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=SCLS Campus Shop <your@mail.com>

# 方案 B：Resend（需要在 Resend 验证自己的域名后才能发给其他人）
RESEND_API_KEY=
# MAIL_FROM=SCLS Campus Shop <noreply@your-domain.com>

# ---- 订单邮件 ----
# 新订单通知的管理员收件人（逗号分隔）；不配则默认通知 202760149 / 202760107 / 202760102 @stu.scls-sh.org
# ADMIN_NOTIFY_EMAILS=a@stu.scls-sh.org,b@stu.scls-sh.org
# 发件人显示名：SMTP 用 SMTP_FROM，Resend 用 MAIL_FROM（见上）
